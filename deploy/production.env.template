# Quantify closed pilot — production environment
#
# Every name here is read by the code. Verified against the source rather than
# transcribed from a plan: two names in the original deployment brief did not
# exist (`QUANTIFY_MARKET_DATA_POLICY` is `PILOT_DATA_POLICY`;
# `QUANTIFY_PROMPT_VERSION` is `QUANTIFY_PARSER_PROMPT_VERSION`), and a
# variable nobody reads is a setting that looks configured and is not.
#
# The application refuses to start rather than serve under an ambiguous
# configuration. Each refusal below is deliberate: see docs/Runbook.md.
#
# Copy to your platform's secret store. Do not commit a filled-in copy.

# ---------------------------------------------------------------- deployment
# Refuses SQLite, refuses an unstated database, refuses an unobservable build,
# refuses an undeclared parser. `local` and `test` are the other values.
QUANTIFY_DEPLOYMENT_PROFILE=production

# ------------------------------------------------------------------ database
# PostgreSQL only in production. There is no fallback: an unset value would
# otherwise open a local SQLite file nobody authorised.
QUANTIFY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/quantify

# -------------------------------------------------------------------- parser
# Declared, never inferred. Production refuses an unset mode: defaulting to
# deterministic would serve a narrower product than the one reviewed — fewer
# recognitions, different blockers — while the startup proof reported a valid
# configuration.
QUANTIFY_PARSER_MODE=MODEL_ASSISTED

# Pinned exactly. An unpinned model changes what a description means without a
# version anyone can cite. Production refuses MODEL_ASSISTED without this.
QUANTIFY_PARSER_MODEL=claude-sonnet-5

# REFUSE (return 503) or EXPLICIT_DETERMINISTIC (fall back and record it).
# REFUSE for the pilot: a silent fallback hands two users different products
# under one deployment and tells neither.
QUANTIFY_PARSER_FALLBACK=REFUSE

# Optional. Defaults to the parser version compiled into the image; set it only
# to pin a prompt revision independently of the build.
# QUANTIFY_PARSER_PROMPT_VERSION=2

# Production refuses MODEL_ASSISTED without a key.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- market data
# The pilot boundary, enforced at runtime. SYNTHETIC_ONLY until all six
# licensing questions are resolved and recorded. The other value is
# `market-data-egress/pilot-vendor-approved@1`, which requires an approved
# vendor snapshot that does not yet exist.
PILOT_DATA_POLICY=SYNTHETIC_ONLY

# Optional. Where price snapshots are cached.
# QUANTIFY_MARKET_DATA_CACHE=/var/lib/quantify/market-data

# ----------------------------------------------------------- build identity
# All four are required in production. A deployment that cannot say which code
# it is running cannot be diagnosed when something else fails, and package
# self-report answers a different question. Set these from CI.
QUANTIFY_COMMIT=
QUANTIFY_RELEASE_REF=
QUANTIFY_IMAGE_DIGEST=
QUANTIFY_SNAPSHOT_ID=

# Optional build facts.
# QUANTIFY_RUNTIME_CONTRACTS_VERSION=

# ----------------------------------------------------------------- telemetry
# Operational traces. Expendable by construction: deleting them changes nothing
# about what a worksheet means. Set empty to disable recording entirely.
QUANTIFY_TRACE_PATH=/var/lib/quantify/trace.db
QUANTIFY_TRACE_RETENTION_DAYS=90
