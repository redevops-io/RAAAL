# No TLS here. The ALB terminates it with an ACM certificate and forwards
# plaintext across a private subnet to this listener.
#
# Caddy remains for one job: basic auth on /workspace/*. That is the entire
# access control for the closed pilot — there are no user accounts, and a
# single `pilot` owner holds every plan. `deploy/acceptance.py` checks it, and
# an ALB has no equivalent, so removing this proxy would delete a control
# while leaving every other part of the deployment looking correct.
{% if quantify_identity_domain | default("") | length > 0 %}
# The identity provider, matched by Host before anything else.
#
# A separate site block rather than a path on the application's: the issuer in
# every token is this hostname, and serving it from a subpath would make the
# discovery document advertise an address that does not answer.
#
# Deliberately outside the basic-auth block below. A login page behind a shared
# password is a door in front of a door, and the credential it asks for is the
# one accounts exist to replace.
http://{{ quantify_identity_domain }} {
	encode gzip
	reverse_proxy identity:8080 {
		# TLS terminates at Cloudflare, so every hop after it is plain HTTP and
		# the provider was told so — it published its issuer as
		# `http://auth.quantify.club`, and the application verifies `iss`
		# exactly, so every token it minted would have been rejected.
		#
		# `ZITADEL_EXTERNALSECURE=true` was set and is not the answer: the
		# provider builds the issuer from the request it receives, and the
		# request genuinely arrives over HTTP. What it needs is the scheme the
		# *browser* used, which is what this header is for.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	log {
		output stdout
		format json
	}
}

{% endif %}
:80 {
	encode gzip

	# Health checks come from the load balancer and must not be authenticated,
	# or an unhealthy-looking target is really just an unauthenticated one.
	handle /health* {
		reverse_proxy api:8000
	}

	# A pilot user typing the hostname wants the product, not the API's service
	# metadata. The root returned that JSON, so the first thing anyone invited to
	# the pilot saw was a document describing the service rather than a way in.
	#
	# Only the exact root. `/info`, `/health*` and `/docs` still answer as
	# themselves, which is where the licence offer and the readiness checks live.
	redir / /workspace/ 302

	handle /workspace/* {
{% if quantify_identity_domain | default("") | length > 0 %}
		# No basic auth here: this deployment has accounts, and the
		# application requires a verified session on these paths. Keeping
		# both would be a login page behind a shared password — a door in
		# front of a door, whose credential is the one accounts exist to
		# replace. Everybody who holds it is the same person, which is
		# precisely what a signed-in workspace stops being true.
		#
		# The guard moved rather than disappeared. It is now
		# `require_a_signed_in_viewer` in `src/api.py`, which redirects to
		# /auth/login instead of prompting for a password — and unlike this
		# block, it knows *who* arrived.
{% else %}
		# Expanded on the host by render-env.sh. A bcrypt hash is not a
		# plaintext password, but it is offline-crackable, so it travels the
		# same path as the secrets rather than through the controller.
		#
		# The configuration with no identity provider, which the pilot ran
		# under for months. One shared credential is not identity, but it is
		# the difference between a private workspace and a public one.
		basic_auth {
			${QUANTIFY_BASIC_AUTH_USER} ${QUANTIFY_BASIC_AUTH_HASH}
		}
{% endif %}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy api:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# The description is a query parameter, and Caddy logs the full URI.
	#
	# A pilot user's financial description was therefore landing verbatim in
	# CloudWatch with thirty-day retention — readable by anyone with log
	# access, and exactly the "raw prompts" the error-surface work was written
	# to keep out of the operator channel. The application already logs the
	# route template rather than the resolved path for this reason; the proxy
	# was undoing it one layer out.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace describe REDACTED
					replace title REDACTED
				}
			}
		}
	}
}
