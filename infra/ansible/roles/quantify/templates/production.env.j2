{#
  Rendered to /opt/quantify/env.template on the host. It holds NO secret
  values: the two placeholders below are shell references, expanded on the
  host by render-env.sh from Secrets Manager using the instance's IAM role.

  That indirection is the point. A template that interpolated the secrets
  directly would pull them through the Ansible controller — into its memory,
  its fact cache, and any -vvv a hurried operator runs while debugging. This
  way the values exist on the host and in Secrets Manager, and nowhere else.
#}
# Generated by Ansible. Do not edit on the host — the next deploy overwrites
# it. Change infra/ansible/roles/quantify/templates/production.env.j2.
#
# Deployed: {{ quantify_build_release_ref }} @ {{ quantify_build_commit }}

QUANTIFY_DEPLOYMENT_PROFILE=production

QUANTIFY_DATABASE_URL=postgresql://quantify:${QUANTIFY_DB_PASSWORD}@{{ quantify_database_host }}:5432/quantify

# --- parser ---------------------------------------------------------------
# Declared, never inferred. Production refuses an unset mode rather than
# defaulting to deterministic, which would serve a narrower product than the
# one reviewed while the startup proof reported a valid configuration.
QUANTIFY_PARSER_MODE={{ quantify_parser_mode }}
QUANTIFY_PARSER_MODEL={{ quantify_parser_model }}
QUANTIFY_PARSER_FALLBACK={{ quantify_parser_fallback }}
{% if quantify_parser_prompt_version | length > 0 %}
QUANTIFY_PARSER_PROMPT_VERSION={{ quantify_parser_prompt_version }}
{% endif %}
ANTHROPIC_API_KEY=${QUANTIFY_MODEL_KEY}

# --- market data ----------------------------------------------------------
# The pilot boundary, enforced at runtime. Fails closed: a vendor policy with
# no approved snapshot resolves nothing and every run refuses.
PILOT_DATA_POLICY={{ quantify_data_policy }}

# --- build identity -------------------------------------------------------
# All four required. The preflight refuses to serve a deployment that cannot
# say which code it is running.
QUANTIFY_COMMIT={{ quantify_build_commit }}
QUANTIFY_RELEASE_REF={{ quantify_build_release_ref }}
QUANTIFY_IMAGE_DIGEST={{ quantify_image | regex_search('@(sha256:[0-9a-f]+)$', '\\1') | first }}
QUANTIFY_SNAPSHOT_ID={{ quantify_build_snapshot_id }}

# --- telemetry ------------------------------------------------------------
# Expendable by construction: deleting these changes nothing about what a
# worksheet means.
QUANTIFY_TRACE_PATH=/var/lib/quantify/trace.db
QUANTIFY_TRACE_RETENTION_DAYS={{ quantify_trace_retention_days }}
