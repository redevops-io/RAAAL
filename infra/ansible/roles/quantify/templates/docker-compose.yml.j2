# Generated by Ansible. The AWS stack, not the self-hosted one:
# `deploy/docker-compose.production.yml` includes a `database` service and
# terminates TLS in Caddy. Here RDS is the database and the ALB terminates
# TLS, so Caddy stays for one reason only — basic auth on /workspace/*, which
# an ALB cannot do and which is the pilot's entire access control.

services:
  api:
    image: "{{ quantify_image }}"
    restart: unless-stopped
    command: ["uvicorn", "src.api:create_app", "--factory",
              "--host", "0.0.0.0", "--port", "8000",
              "--proxy-headers", "--forwarded-allow-ips", "*"]
    env_file: [/opt/quantify/.env]
    expose: ["8000"]
    volumes:
      # Telemetry only. Losing this volume costs traces and no financial
      # artifact — a property the suite tests rather than assumes.
      - /var/lib/quantify:/var/lib/quantify
    healthcheck:
      test: ["CMD", "python", "-c",
             "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health/ready', timeout=5).status == 200 else 1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      # Straight to CloudWatch. The runbook's support procedure is "grep the
      # log for the id the user quoted", and a log that only exists inside a
      # container is one an operator has to reach the host to read — at
      # exactly the moment the host may be the problem.
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "api"
        awslogs-create-group: "false"

  proxy:
    image: caddy:2
    restart: unless-stopped
    # Bound to the host's private address only. The security group already
    # restricts this to the load balancer; binding narrowly as well means a
    # security-group mistake is not immediately an open workspace.
    ports: ["80:80"]
    volumes:
      - /opt/quantify/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on: [api]
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "proxy"
        awslogs-create-group: "false"

volumes:
  caddy-data:
  caddy-config:
