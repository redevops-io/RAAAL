# Generated by Ansible. The AWS stack, not the self-hosted one:
# `deploy/docker-compose.production.yml` includes a `database` service and
# terminates TLS in Caddy. Here RDS is the database and the ALB terminates
# TLS, so Caddy stays for one reason only — basic auth on /workspace/*, which
# an ALB cannot do and which is the pilot's entire access control.

services:
  api:
    image: "{{ quantify_image }}"
    restart: unless-stopped
    # `--no-access-log`, because uvicorn logs the full request line including
    # the query string — and the description is a query parameter, so a user's
    # financial words were reaching CloudWatch from here as well as from the
    # proxy. Redacting one and not the other would have left the leak while
    # looking fixed.
    #
    # Only `uvicorn.access` is silenced. `uvicorn.error` is the operator
    # channel that carries sanitised failures and correlation ids, and it
    # keeps working; the proxy's redacted log is the access record.
    command: ["uvicorn", "src.api:create_app", "--factory",
              "--host", "0.0.0.0", "--port", "8000", "--no-access-log",
              "--proxy-headers", "--forwarded-allow-ips", "*"]
    env_file: [/opt/quantify/.env]
    expose: ["8000"]
    volumes:
      # Telemetry only. Losing this volume costs traces and no financial
      # artifact — a property the suite tests rather than assumes.
      - /var/lib/quantify:/var/lib/quantify
    healthcheck:
      test: ["CMD", "python", "-c",
             "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health/ready', timeout=5).status == 200 else 1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      # Straight to CloudWatch. The runbook's support procedure is "grep the
      # log for the id the user quoted", and a log that only exists inside a
      # container is one an operator has to reach the host to read — at
      # exactly the moment the host may be the problem.
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "api"
        awslogs-create-group: "false"

{% if quantify_identity_domain | default("") | length > 0 %}
  # The identity provider. Same host, same database server, its own database.
  #
  # `--tlsMode external` because TLS terminates at Cloudflare and the hop from
  # the tunnel to here is inside the VPC — Zitadel refuses to start if it
  # believes it is serving plaintext to the public, and telling it the truth is
  # better than giving it a certificate it does not need.
  #
  # `EXTERNALDOMAIN` is what it publishes as its issuer and what every token
  # carries as `iss`. It has to be the name the browser uses, or discovery
  # advertises an address nobody can reach.
  identity:
    image: ghcr.io/zitadel/zitadel:v2.65.1
    restart: unless-stopped
    command: >-
      start-from-init --masterkeyFromEnv --tlsMode external
    env_file: [/opt/quantify/.env]
    expose: ["8080"]
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "identity"
        awslogs-create-group: "false"

{% endif %}
  proxy:
    image: caddy:2
    restart: unless-stopped
    # Bound to the host's private address only. The security group already
    # restricts this to the load balancer; binding narrowly as well means a
    # security-group mistake is not immediately an open workspace.
    ports: ["80:80"]
    volumes:
      - /opt/quantify/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on: [api]
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "proxy"
        awslogs-create-group: "false"

  # The only ingress path. `cloudflared` dials out to Cloudflare and holds the
  # connection open; nothing listens on a public address anywhere in this
  # deployment. Its ingress rules live in Cloudflare (config_src = "cloudflare"
  # on the tunnel resource), so routing is one declarative thing rather than a
  # copy here that can disagree with it.
  #
  # Pinned by digest, like the application image. `:latest` on the component
  # that terminates every user request is the same moving target, and a
  # connector that silently changed version would be indistinguishable from a
  # deployment that did not.
  tunnel:
    image: cloudflare/cloudflared@sha256:b77d84e8704db38db22c22661cf7e56468c526e3a6a5fe9c8b7c151452fa1472
    restart: unless-stopped
    command: ["tunnel", "--no-autoupdate", "--metrics", "0.0.0.0:2000", "run"]
    # TUNNEL_TOKEN only. Written on the host at 0600, never in this file.
    env_file: [/opt/quantify/tunnel.env]
    depends_on: [proxy]
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ quantify_region }}"
        awslogs-group: "{{ quantify_log_group }}"
        awslogs-stream: "tunnel"
        awslogs-create-group: "false"

volumes:
  caddy-data:
  caddy-config:
