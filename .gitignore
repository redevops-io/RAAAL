# Virtual environments
.venv/
.venv-*/
**/.venv/
**/.venv-*/
venv/
ENV/
env/

# Data and cache. Written as `data/*` rather than `data/` so git still descends
# and the negation below can take effect — an ignored *directory* is never
# entered, and `!data/manifests/` under `data/` would silently do nothing.
data/*
!data/manifests/

# Dataset manifests are committed even though the datasets are not. They carry
# the snapshot identity, version and hash, so a result can name the input it was
# computed against without the licensed bytes ever entering the repository.


# Reports (except the latest dashboard)
reports/*.csv
reports/*.json
reports/allocation_*.csv
reports/allocation_*.json
reports/state.json
reports/index.html

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local AI tooling. Chat transcripts and a symbol cache are one developer's
# working state, and the transcripts can carry pasted secrets and private
# scenario text — neither belongs in a repository whose boundary rules exist to
# keep personal data out of public artifacts.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node modules (for wrangler)
node_modules/
package-lock.json

# Logs
*.log
.wrangler/

# Docker
.dockerignore
# Claude Code local session dir
.claude/
